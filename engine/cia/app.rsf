# app.rsf -- Rom Specification File for makerom (the engine's CIA build)
#
# This is the file that decides how much RAM the title gets, via SystemModeExt
# (filled in by build_cia.ps1). A .3dsx build cannot ask for a mode at all -- it
# lives in the title's extended header, which 3dsx files do not have. On an Old
# 3DS, SystemMode (64MB) applies instead.
#
# Hardware result (New 3DS XL, Luma3DS, 2026-10-19, the M1 test app):
#   124MB  runs: HOME-menu launch, 59 fps, reports 124 MB.   <- the default
#   178MB  black screen. This "Dev1" extended mode is used by no retail game and
#          does not run the HOME menu; it stays experimental until shown working.
#
# Everything else is the standard homebrew title configuration (permissions, SVC
# access, service list, system module dependencies) taken from makerom's own
# sample RSF, which is known to install and run on Luma3DS, plus the services
# this engine adds: dsp::DSP (NDSP) and ptm:sysm (osSetSpeedupEnable, which
# reapplies 804 MHz + L2 after a return from HOME).

BasicInfo:
  Title                   : To the Moon 3DS
  ProductCode             : CTR-P-TTM3
  Logo                    : Nintendo        # splash shown after launch

RomFs:
  # makerom packs this directory as the title's read-only filesystem: the
  # engine's Ruby (main.rb, boot.rb, rgss/) and, if build.ps1 found it,
  # audio.ttma (the game's music: this CIA is for the owner's console only,
  # like the 3dsx).
  RootPath                : romfs

TitleInfo:
  Category                : Application
  UniqueId                : 0xff3fe         # the M1 test app keeps 0xff3ff, so both can be installed

Option:
  UseOnSD                 : true            # install to the SD card
  FreeProductCode         : true            # ignore ProductCode restrictions
  MediaFootPadding        : false
  EnableCrypt             : false           # no encryption (Luma3DS patches signatures)
  EnableCompress          : false           # keep the exefs uncompressed: fewer things to go wrong on first boot

AccessControlInfo:
  CoreVersion                   : 2
  DescVersion                   : 2
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"

  UseExtSaveData                : false

  # The game itself is on the SD card (to the Moon.rgssad, the saves and the
  # log); romfs only holds the engine's Ruby and the audio pack.
  FileSystemAccess:
   - DirectSdmc

  MemoryType                    : Application
  SystemMode                    : 64MB            # Old 3DS mode: 64MB(Default)/96MB/80MB/72MB/32MB
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0
  HandleTableSize               : 0x200
  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true

  # ---- New 3DS process settings: this is the whole point of the CIA build ----
  # 124MB is the mode verified on hardware; 178MB (extended memory) black-
  # screened there. build_cia.ps1 passes 124MB to makerom -D.
  SystemModeExt                 : $(APP_SYSTEM_MODE_EXT)
  CpuSpeed                      : 804MHz          # 268MHz(Default)/804MHz
  EnableL2Cache                 : true
  CanAccessCore2                : true

  IORegisterMapping:
   - 1ff00000-1ff7ffff   # DSP memory
  MemoryMapping:
   - 1f000000-1f5fffff:r # VRAM

  # Accessible SVCs, <Name>:<ID> -- the standard homebrew set
  SystemCallAccess:
    ArbitrateAddress: 34
    Break: 60
    CancelTimer: 28
    ClearEvent: 25
    ClearTimer: 29
    CloseHandle: 35
    ConnectToPort: 45
    ControlMemory: 1
    CreateAddressArbiter: 33
    CreateEvent: 23
    CreateMemoryBlock: 30
    CreateMutex: 19
    CreateSemaphore: 21
    CreateThread: 8
    CreateTimer: 26
    DuplicateHandle: 39
    ExitProcess: 3
    ExitThread: 9
    GetCurrentProcessorNumber: 17
    GetHandleInfo: 41
    GetProcessId: 53
    GetProcessIdOfThread: 54
    GetProcessIdealProcessor: 6
    GetProcessInfo: 43
    GetResourceLimit: 56
    GetResourceLimitCurrentValues: 58
    GetResourceLimitLimitValues: 57
    GetSystemInfo: 42
    GetSystemTick: 40
    GetThreadContext: 59
    GetThreadId: 55
    GetThreadIdealProcessor: 15
    GetThreadInfo: 44
    GetThreadPriority: 11
    MapMemoryBlock: 31
    OutputDebugString: 61
    QueryMemory: 2
    ReleaseMutex: 20
    ReleaseSemaphore: 22
    SendSyncRequest1: 46
    SendSyncRequest2: 47
    SendSyncRequest3: 48
    SendSyncRequest4: 49
    SendSyncRequest: 50
    SetThreadPriority: 12
    SetTimer: 27
    SignalEvent: 24
    SleepThread: 10
    UnmapMemoryBlock: 32
    WaitSynchronization1: 36
    WaitSynchronizationN: 37
    Backdoor: 123

  # Services the app uses: cfg (model detection), fs (SD card), gsp (GPU),
  # hid (buttons), APT (applet lifecycle), and the rest are harmless to allow.
  ServiceAccessControl:
   - cfg:u
   - fs:USER
   - gsp::Gpu
   - hid:USER
   - ndm:u
   - pxi:dev
   - APT:U
   - ac:u
   - am:net
   - boss:U
   - cam:u
   - cecd:u
   - csnd:SND
   - dsp::DSP
   - frd:u
   - http:C
   - ir:USER
   - ir:rst
   - ldr:ro
   - mic:u
   - news:u
   - nim:aoc
   - nwm::UDS
   - ptm:u
   - ptm:sysm
   - qtm:u
   - soc:U
   - ssl:C
   - y2r:u

SystemControlInfo:
  SaveDataSize: 0K
  RemasterVersion: 0
  # 1 MB: mruby's parser and code generator recurse on the C stack. A CIA takes
  # its main-thread stack from the exheader, not the 3dsx's __stacksize__.
  StackSize: 0x100000

  # Modules that must be present. Every one of these ships with the system;
  # listing a module that is missing makes the title hang at the logo.
  Dependency:
    ac: 0x0004013000002402
    am: 0x0004013000001502
    boss: 0x0004013000003402
    camera: 0x0004013000001602
    cecd: 0x0004013000002602
    cfg: 0x0004013000001702
    codec: 0x0004013000001802
    csnd: 0x0004013000002702
    dlp: 0x0004013000002802
    dsp: 0x0004013000001a02
    friends: 0x0004013000003202
    gpio: 0x0004013000001b02
    gsp: 0x0004013000001c02
    hid: 0x0004013000001d02
    http: 0x0004013000002902
    i2c: 0x0004013000001e02
    ir: 0x0004013000003302
    mcu: 0x0004013000001f02
    mic: 0x0004013000002002
    ndm: 0x0004013000002b02
    news: 0x0004013000003502
    nim: 0x0004013000002c02
    nwm: 0x0004013000002d02
    pdn: 0x0004013000002102
    ps: 0x0004013000003102
    ptm: 0x0004013000002202
    ro: 0x0004013000003702
    socket: 0x0004013000002e02
    spi: 0x0004013000002302
    ssl: 0x0004013000002f02
